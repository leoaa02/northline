{
  "extends": "../../tsconfig.base.json",
  "include": [
    "app/**/*",
    "components/**/*",
    "hooks/**/*",
    "lib/**/*",
    "next-env.d.ts",
    "sanity/**/*",
    "services/**/*",
    "src/**/*",
    "styles/**/*",
    "types/**/*",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "build",
    "dist",
    "**/*.test.ts"
  ],
  "compilerOptions": {
    "noEmit": true,
    "jsx": "preserve",
    "lib": [
      "esnext",
      "dom",
      "dom.iterable"
    ],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "ignoreDeprecations": "5.0",
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@/src/*": [
        "./src/*"
      ],
      "@/components/*": [
        "./components/*",
        "./src/components/*"
      ],
      "@/lib/*": [
        "./lib/*",
        "./src/lib/*"
      ],
      "@/hooks/*": [
        "./hooks/*",
        "./src/hooks/*"
      ],
      "@/data/*": [
        "./src/data/*"
      ],
      "@/services/*": [
        "./services/*"
      ],
      "@/sanity/*": [
        "./sanity/*"
      ],
      "@/types/*": [
        "./types/*"
      ],
      "@/views/*": [
        "./src/views/*"
      ]
    },
    "allowJs": true,
    "strict": false,
    "esModuleInterop": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "references": [
    {
      "path": "../../lib/api-client-react"
    }
  ]
}
